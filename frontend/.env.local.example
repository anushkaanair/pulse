# Point the frontend at your local backend (see backend/ setup).
NEXT_PUBLIC_API_URL=http://localhost:4000
# false = talk to the real backend above. true = use the built-in mock data
# layer instead (zero backend needed — used for local dev and the e2e tests).
NEXT_PUBLIC_USE_MOCK=false
# Shows the fault-injection dev panel (the live resilience demo).
NEXT_PUBLIC_SIM_ADMIN=true
