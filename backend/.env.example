PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/watchlist
LOG_LEVEL=info

# Market data
TICK_MS=1000            # simulator emits one tick per symbol per interval
SIM_SEED=42             # deterministic simulator; change for a different market
SIM_ADMIN=true          # expose POST /api/_sim/faults (demo + torture test).
                        # Unauthenticated by design, so it defaults to FALSE in
                        # code: enable it deliberately for local demos, never by
                        # inheriting a default in a deployed environment.
STALE_AFTER_SECONDS=90  # a quote older than this is flagged stale
HISTORY_RETENTION_DAYS=30  # prune quote_history older than this; 0 disables
HISTORY_PRUNE_MS=3600000   # how often the retention sweep runs

# Hardening (see RESILIENCE.md)
RATE_LIMIT_RPM=1200     # per-identity request budget; 0 disables (load scripts do)
RATE_LIMIT_BURST=120
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# "Meaningful" definition
Z_THRESHOLD=2.0         # |move / trailing sigma| at or above this is meaningful
MAX_HORIZON_HOURS=6.25  # longest absence the sqrt(n) scaling models before the
                        # bar stops growing (one NSE session). Uncapped, a long
                        # absence silently reports LESS — see DECISIONS.md.
HISTORY_WINDOW=50       # ticks used for trailing sigma
MIN_HISTORY=20          # below this, fall back to ABS_THRESHOLD_PCT
ABS_THRESHOLD_PCT=1.5   # fallback threshold when history is thin
POOL_MAX=20
